{
  "$description": "kimi-k3 design system tokens for www.jackzhaojin.com, DTCG 2025.10 format. Colors are hex strings as in the round contract. Fluid type sizes carry the CSS clamp() in $extensions and list the maximum as $value. Semantic color tokens reference primitives by name in tokens.css; this file lists the resolved values per theme.",
  "font": {
    "$description": "Two families. Inter carries display, headings and body. IBM Plex Mono carries labels, chips, bylines, tables and code.",
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Display and headings"
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "-apple-system",
          "Segoe UI",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Body copy"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Mono",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Labels, chips, bylines, tables, code"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Body"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Emphasis, nav, chips"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Headings and wordmark"
      }
    },
    "leading": {
      "tight": {
        "$type": "number",
        "$value": 1.12,
        "$description": "Headings"
      },
      "body": {
        "$type": "number",
        "$value": 1.7,
        "$description": "Body copy"
      }
    },
    "tracking": {
      "label": {
        "$type": "dimension",
        "$value": {
          "value": 0.12,
          "unit": "em"
        },
        "$description": "Uppercase mono labels"
      },
      "heading": {
        "$type": "dimension",
        "$value": {
          "value": -0.02,
          "unit": "em"
        },
        "$description": "Headings"
      }
    }
  },
  "size": {
    "$description": "Type scale. Fluid steps use clamp(); the $value is the maximum.",
    "display": {
      "$type": "dimension",
      "$value": {
        "value": 96,
        "unit": "px"
      },
      "$description": "Home H1 only",
      "$extensions": {
        "com.jackzhaojin.css": "clamp(3rem, 8vw, 6rem)"
      }
    },
    "h1": {
      "$type": "dimension",
      "$value": {
        "value": 54.4,
        "unit": "px"
      },
      "$description": "Page title",
      "$extensions": {
        "com.jackzhaojin.css": "clamp(2rem, 4.6vw, 3.4rem)"
      }
    },
    "h2": {
      "$type": "dimension",
      "$value": {
        "value": 29.6,
        "unit": "px"
      },
      "$description": "Section heading",
      "$extensions": {
        "com.jackzhaojin.css": "clamp(1.35rem, 2.6vw, 1.85rem)"
